rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /entries/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /favorites/{uid}/{fid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
